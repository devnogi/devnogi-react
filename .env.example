# Local Docker only. For host npm run dev, use http://localhost:8090 instead.
NODE_ENV=development
PORT=3010
VERCEL_ENV=development
API_MOCKING=disabled
GATEWAY_URL=http://host.docker.internal:8090
LOG_LEVEL=INFO
# Match auth's local cookie scope. Unset values retain production defaults.
JWT_COOKIE_DOMAIN=
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax
